{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./tsconfig.test.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": ".test-dist",
    "sourceMap": true,
    "noEmit": false
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.d.ts",
    "tests/**/*.test.ts",
    "tests/helpers/**/*.ts"
  ]
}
